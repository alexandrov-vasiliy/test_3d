# Auto-detect text files and normalize line endings in the repository.
* text=auto

# Source code and project text files
*.cs text eol=lf diff=csharp
*.shader text eol=lf
*.hlsl text eol=lf
*.cginc text eol=lf
*.json text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.inputactions text eol=lf
*.uxml text eol=lf
*.uss text eol=lf
*.xml text eol=lf
*.txt text eol=lf
*.md text eol=lf

# Unity serialized YAML assets.
# Configure UnityYAMLMerge locally for semantic merges:
# git config merge.unityyamlmerge.name "Unity SmartMerge"
# git config merge.unityyamlmerge.driver "'/Applications/Unity/Hub/Editor/2022.3.62f2/Unity.app/Contents/Tools/UnityYAMLMerge' merge -p %O %A %B %A"
*.unity text eol=lf merge=unityyamlmerge
*.prefab text eol=lf merge=unityyamlmerge
*.asset text eol=lf merge=unityyamlmerge
*.mat text eol=lf merge=unityyamlmerge
*.anim text eol=lf merge=unityyamlmerge
*.controller text eol=lf merge=unityyamlmerge
*.overrideController text eol=lf merge=unityyamlmerge
*.playable text eol=lf merge=unityyamlmerge
*.mask text eol=lf merge=unityyamlmerge
*.meta text eol=lf merge=unityyamlmerge

